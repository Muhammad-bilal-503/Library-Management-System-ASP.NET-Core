@model LibraryMS.Models.Member
@{
    ViewData["Title"] = "Delete Member";
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="card-custom p-4 text-center">
            <div style="font-size:3rem;margin-bottom:1rem">⚠️</div>
            <h3 style="font-family:'Playfair Display',serif;color:#ff6b6b">Delete Member?</h3>
            <p style="color:#8b8fa8">This will permanently remove the member from the system.</p>
            <div style="background:#1a1e2e;border-radius:12px;padding:1.5rem;margin:1.5rem 0">
                <div style="width:60px;height:60px;background:linear-gradient(135deg,#c9a84c,#e8c97a);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;font-weight:700;color:#0d0f12;margin:0 auto 1rem">
                    @Model.FullName[0]
                </div>
                <h5>@Model.FullName</h5>
                <div style="color:#8b8fa8">@Model.Email</div>
                <div class="mt-2"><code style="color:#c9a84c">@Model.MembershipId</code></div>
            </div>
            <div class="d-flex gap-3 justify-content-center">
                <form method="post" action="/Members/Delete/@Model.Id">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn px-5" style="background:#ff6b6b;color:white;border-radius:10px;font-weight:600">
                        <i class="fas fa-trash me-2"></i>Delete
                    </button>
                </form>
                <a href="/Members" class="btn btn-outline-gold px-5">Cancel</a>
            </div>
        </div>
    </div>
</div>
