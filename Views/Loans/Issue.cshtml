@{
    ViewData["Title"] = "Issue Book";
}

<div class="mb-3">
    <a href="/Loans" style="color:#8b8fa8;text-decoration:none;font-size:0.9rem">
        <i class="fas fa-arrow-left me-1"></i> Back to Loans
    </a>
</div>

<div class="page-header">
    <div>
        <h1 class="page-title">📤 Issue a Book</h1>
        <p class="page-subtitle">Assign a book to a library member</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card-custom p-4">
            <form method="post" action="/Loans/Issue">
                @Html.AntiForgeryToken()
                <div class="mb-4">
                    <label class="form-label">Select Book *</label>
                    <select name="BookId" class="form-select form-control-custom" required id="bookSelect">
                        <option value="">-- Choose an available book --</option>
                        @foreach (var item in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Books)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                    <div class="small mt-1" style="color:#8b8fa8">Only books with available copies are shown.</div>
                </div>
                <div class="mb-4">
                    <label class="form-label">Select Member *</label>
                    <select name="MemberId" class="form-select form-control-custom" required>
                        <option value="">-- Choose a member --</option>
                        @foreach (var item in (Microsoft.AspNetCore.Mvc.Rendering.SelectList)ViewBag.Members)
                        {
                            <option value="@item.Value">@item.Text</option>
                        }
                    </select>
                    <div class="small mt-1" style="color:#8b8fa8">Members can have a maximum of 3 active loans.</div>
                </div>
                <div class="mb-4">
                    <label class="form-label">Notes (Optional)</label>
                    <textarea name="Notes" class="form-control form-control-custom" rows="2" placeholder="Any special notes..."></textarea>
                </div>

                <!-- Info box -->
                <div style="background:rgba(201,168,76,0.07);border:1px solid rgba(201,168,76,0.2);border-radius:12px;padding:1rem;margin-bottom:1.5rem">
                    <div class="d-flex align-items-center gap-2 mb-2" style="color:#c9a84c;font-weight:600">
                        <i class="fas fa-info-circle"></i> Loan Policy
                    </div>
                    <ul class="mb-0 small" style="color:#b0b4c8;padding-left:1.2rem">
                        <li>Default loan period: <strong style="color:#e8c97a">14 days</strong></li>
                        <li>Fine for late return: <strong style="color:#e8c97a">Rs. 10 per day</strong></li>
                        <li>Maximum active loans per member: <strong style="color:#e8c97a">3 books</strong></li>
                    </ul>
                </div>

                <div class="d-flex gap-3">
                    <button type="submit" class="btn btn-gold px-5">
                        <i class="fas fa-hand-holding me-2"></i>Issue Book
                    </button>
                    <a href="/Loans" class="btn btn-outline-gold px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
