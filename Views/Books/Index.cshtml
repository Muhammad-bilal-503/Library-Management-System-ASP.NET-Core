@model List<LibraryMS.Models.Book>
@{
    ViewData["Title"] = "Books";
}

<div class="page-header">
    <div>
        <h1 class="page-title">📚 Books Collection</h1>
        <p class="page-subtitle">@Model.Count books found</p>
    </div>
    <a href="/Books/Create" class="btn btn-gold px-4">
        <i class="fas fa-plus me-2"></i>Add Book
    </a>
</div>

<!-- Search & Filter -->
<form method="get" class="search-bar">
    <div class="row g-2 align-items-center">
        <div class="col-md-5">
            <div class="input-group">
                <span class="input-group-text" style="background:#1a1e2e;border-color:rgba(201,168,76,0.15);color:#8b8fa8"><i class="fas fa-search"></i></span>
                <input type="text" name="search" value="@ViewBag.Search" placeholder="Search by title, author, ISBN..."
                       class="form-control form-control-custom" style="border-left:0" />
            </div>
        </div>
        <div class="col-md-3">
            <select name="genre" class="form-select form-control-custom">
                <option value="">All Genres</option>
                @foreach (var g in (List<string>)ViewBag.Genres)
                {
                    if (ViewBag.Genre == g)
                    {
                        <option value="@g" selected="selected">@g</option>
                    }
                    else
                    {
                        <option value="@g">@g</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-2">
            <select name="availability" class="form-select form-control-custom">
                <option value="">Any Status</option>
                @if (ViewBag.Availability == "available")
                {
                    <option value="available" selected="selected">Available</option>
                    <option value="unavailable">Unavailable</option>
                }
                else if (ViewBag.Availability == "unavailable")
                {
                    <option value="available">Available</option>
                    <option value="unavailable" selected="selected">Unavailable</option>
                }
                else
                {
                    <option value="available">Available</option>
                    <option value="unavailable">Unavailable</option>
                }
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-gold flex-fill">Search</button>
            <a href="/Books" class="btn btn-outline-gold">Reset</a>
        </div>
    </div>
</form>

<!-- Books Grid -->
@if (Model.Count == 0)
{
    <div class="text-center py-5" style="color:#8b8fa8">
        <div style="font-size:4rem">📭</div>
        <h4 class="mt-3">No books found</h4>
        <a href="/Books/Create" class="btn btn-gold mt-3">Add First Book</a>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var book in Model)
        {
            <div class="col-xl-2 col-lg-3 col-md-4 col-sm-6">
                <div class="book-card h-100">
                    <!-- Cover Image from Open Library -->
                    <div style="position:relative">
                        <img src="https://covers.openlibrary.org/b/isbn/@book.ISBN.Replace("-","")-M.jpg"
                             alt="@book.Title"
                             class="book-cover"
                             onerror="this.style.display='none';document.getElementById('ph-@book.Id').style.display='flex'" />
                        <div id="ph-@book.Id" class="book-cover-placeholder" style="display:none">
                            <div style="text-align:center">
                                <div style="font-size:2.5rem">📖</div>
                                <div style="font-size:0.7rem;color:#8b8fa8;margin-top:0.5rem;padding:0 0.5rem">@book.Title</div>
                            </div>
                        </div>
                        <div style="position:absolute;top:0.5rem;right:0.5rem">
                            <span class="badge @(book.IsAvailable ? "badge-available" : "badge-unavailable")" style="font-size:0.65rem">
                                @(book.IsAvailable ? "✓" : "×")
                            </span>
                        </div>
                    </div>

                    <div class="p-3 d-flex flex-column h-100">
                        <div class="mb-1">
                            <span class="badge badge-genre" style="font-size:0.65rem">@book.Genre</span>
                        </div>
                        <h6 class="fw-600 mb-1" style="font-size:0.85rem;line-height:1.3" title="@book.Title">
                            @(book.Title.Length > 35 ? book.Title.Substring(0,35) + "…" : book.Title)
                        </h6>
                        <div class="small mb-2" style="color:#8b8fa8">@book.Author</div>
                        <div class="small mb-3" style="color:#8b8fa8">
                            @book.AvailableCopies / @book.TotalCopies copies available
                        </div>
                        <div class="mt-auto d-flex gap-1">
                            <a href="/Books/Details/@book.Id" class="btn btn-outline-gold btn-sm flex-fill" style="font-size:0.75rem">View</a>
                            <a href="/Books/Edit/@book.Id" class="btn btn-sm" style="background:rgba(91,138,245,0.1);color:#5b8af5;border:1px solid rgba(91,138,245,0.3);border-radius:8px;font-size:0.75rem"><i class="fas fa-edit"></i></a>
                            <a href="/Books/Delete/@book.Id" class="btn btn-sm" style="background:rgba(255,107,107,0.1);color:#ff6b6b;border:1px solid rgba(255,107,107,0.3);border-radius:8px;font-size:0.75rem"><i class="fas fa-trash"></i></a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
